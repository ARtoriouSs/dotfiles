#!/bin/bash
# blocks a commit with secrets (API keys, tokens, private keys) in staged changes
# enabled by `git config core.hooksPath .githooks` (bin/prepare.sh does it),
# false positives go to .gitleaksignore, skip the check once with `git commit --no-verify`

if ! command -v gitleaks > /dev/null; then
  echo "gitleaks is not installed (bin/install_cli.sh installs it), commit is blocked" >&2
  echo "skip the check once with: git commit --no-verify" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
